<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212">
    <LinearLayout
        android:orientation="vertical"
        android:padding="24dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SF2 Vision Farmer"
            android:textColor="#ffffff"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#cccccc"
            android:textSize="15sp"
            android:text="Noch nicht gestartet" />

        <Button
            android:id="@+id/accessibilityBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="1. Bedienungshilfe aktivieren" />

        <Spinner
            android:id="@+id/profileSpinner"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp" />

        <CheckBox
            android:id="@+id/autoAdvance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="KÄMPFT! und OK automatisch drücken"
            android:textColor="#ffffff"
            android:checked="true" />

        <Button
            android:id="@+id/startBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="2. Bot starten + SF2 öffnen" />

        <Button
            android:id="@+id/stopBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Bot stoppen" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:textColor="#9e9e9e"
            android:textSize="13sp"
            android:text="Überleben in der ersten Arena auswählen, dann Bot starten. Bei der Aufnahme den gesamten Bildschirm wählen. Im Kampf wird nur Schlagen gedrückt: keine Bewegung, keine Tritte, kein Lernen. In Menüs drückt er ausschließlich KÄMPFT! rechts unten und OK unten in der Mitte. STOP ist in der Benachrichtigung." />
    </LinearLayout>
</ScrollView>

